{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mothlight-interactive.github.io/wikihop-puzzles/schemas/v1.schema.json",
  "title": "WikiHop static API, format 1 (frozen)",
  "description": "One definition per file kind under /v1/. Validate a file against {\"$ref\": \"#/$defs/<kind>\"}.",
  "$defs": {
    "format": {"const": 1},
    "lang": {"type": "string", "pattern": "^[a-z]{2,8}$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "pairId": {"type": "string", "pattern": "^[a-z]{2,8}-\\d+-\\d+$"},
    "title": {"type": "string", "minLength": 1},
    "par": {"type": "integer", "minimum": 1, "maximum": 6},
    "side": {
      "type": "object",
      "required": ["title", "revid"],
      "additionalProperties": false,
      "properties": {"title": {"$ref": "#/$defs/title"}, "revid": {"type": "integer", "minimum": 1}}
    },
    "route": {"type": "array", "minItems": 2, "maxItems": 7, "items": {"$ref": "#/$defs/title"}},

    "languages": {
      "type": "object",
      "required": ["format", "languages"],
      "additionalProperties": false,
      "properties": {
        "format": {"$ref": "#/$defs/format"},
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "name", "first"],
            "additionalProperties": false,
            "properties": {
              "code": {"$ref": "#/$defs/lang"},
              "name": {"type": "string", "minLength": 1},
              "first": {"$ref": "#/$defs/date"}
            }
          }
        }
      }
    },
    "latest": {
      "type": "object",
      "required": ["format", "lang", "first", "latest", "minAppVersion"],
      "additionalProperties": false,
      "properties": {
        "format": {"$ref": "#/$defs/format"},
        "lang": {"$ref": "#/$defs/lang"},
        "first": {"$ref": "#/$defs/date"},
        "latest": {"$ref": "#/$defs/date"},
        "minAppVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
      }
    },
    "daily": {
      "type": "object",
      "required": ["format", "lang", "id", "number", "date", "start", "target", "snapshotAt", "par"],
      "additionalProperties": false,
      "properties": {
        "format": {"$ref": "#/$defs/format"},
        "lang": {"$ref": "#/$defs/lang"},
        "id": {"$ref": "#/$defs/pairId"},
        "number": {"type": "integer", "minimum": 1},
        "date": {"$ref": "#/$defs/date"},
        "start": {"$ref": "#/$defs/side"},
        "target": {"$ref": "#/$defs/side"},
        "snapshotAt": {"type": "string", "minLength": 20},
        "par": {"$ref": "#/$defs/par"}
      }
    },
    "solution": {
      "type": "object",
      "required": ["format", "lang", "id", "number", "par", "route"],
      "additionalProperties": false,
      "properties": {
        "format": {"$ref": "#/$defs/format"},
        "lang": {"$ref": "#/$defs/lang"},
        "id": {"$ref": "#/$defs/pairId"},
        "number": {"type": "integer", "minimum": 1},
        "par": {"$ref": "#/$defs/par"},
        "route": {"$ref": "#/$defs/route"}
      }
    },
    "pool": {
      "type": "object",
      "required": ["format", "lang", "pool", "pairs"],
      "additionalProperties": false,
      "properties": {
        "format": {"$ref": "#/$defs/format"},
        "lang": {"$ref": "#/$defs/lang"},
        "pool": {"type": "integer", "minimum": 1},
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "start", "target", "snapshotAt", "par", "route"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/pairId"},
              "start": {"$ref": "#/$defs/side"},
              "target": {"$ref": "#/$defs/side"},
              "snapshotAt": {"type": "string", "minLength": 20},
              "par": {"$ref": "#/$defs/par"},
              "route": {"$ref": "#/$defs/route"}
            }
          }
        }
      }
    },
    "index": {
      "type": "object",
      "required": ["format", "lang", "pools"],
      "additionalProperties": false,
      "properties": {
        "format": {"$ref": "#/$defs/format"},
        "lang": {"$ref": "#/$defs/lang"},
        "pools": {"type": "array", "items": {"type": "string", "pattern": "^pool-\\d{4}\\.json$"}}
      }
    },
    "retired": {
      "type": "object",
      "required": ["format", "lang", "ids"],
      "additionalProperties": false,
      "properties": {
        "format": {"$ref": "#/$defs/format"},
        "lang": {"$ref": "#/$defs/lang"},
        "ids": {"type": "array", "items": {"$ref": "#/$defs/pairId"}}
      }
    }
  }
}
